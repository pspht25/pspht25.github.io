---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { tools } from '../data/tools';
import { demos } from '../data/demos';
import { SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <h1>🏝️ 心屿</h1>
    <p class="hero-sub">XĪN YǓ · 个人知识岛屿</p>
    <p class="hero-desc">{SITE_DESCRIPTION}</p>
  </section>

  <section class="home-section">
    <h2>最新文章 <a class="more" href="/blog/">全部 →</a></h2>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>
            <span class="post-title">{post.data.title}</span>
            {post.data.description && <span class="post-desc">{post.data.description}</span>}
            <span class="post-meta"><FormattedDate date={post.data.pubDate} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section">
    <h2>工具箱 <a class="more" href="/tools/">进入 →</a></h2>
    <div class="card-grid">
      {tools.filter((t) => t.ready).map((tool) => (
        <a class="card" href={tool.path}>
          <span class="card-emoji">{tool.emoji}</span>
          <span class="card-title">{tool.title}</span>
          <span class="card-desc">{tool.description}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section">
    <h2>演示集 <a class="more" href="/demos/">进入 →</a></h2>
    <div class="card-grid">
      {demos.filter((d) => d.ready).map((demo) => (
        <a class="card" href={`/demos/${demo.slug}/`}>
          <span class="card-emoji">{demo.emoji}</span>
          <span class="card-title">{demo.title}</span>
          <span class="card-desc">{demo.description}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
