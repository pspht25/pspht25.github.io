---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { demos } from '../../data/demos';

export function getStaticPaths() {
  return demos
    .filter((demo) => demo.ready)
    .map((demo) => ({ params: { slug: demo.slug }, props: { demo } }));
}

const { demo } = Astro.props;
---

<BaseLayout title={demo.title} description={demo.description}>
  <div class="demo-stage" id="demo-stage">
    <iframe
      class="demo-frame"
      src={`/demos/${demo.file}`}
      title={demo.title}
    ></iframe>
    <div class="demo-fab-wrap">
      <button class="demo-fab" id="demo-fab" type="button" aria-label="演示控制">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
      </button>
      <div class="demo-fab-menu" id="demo-fab-menu" hidden>
        <a href={`/demos/${demo.file}`} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
          <span>全屏打开</span>
        </a>
        {demo.zip ? (
          <a href={`/demos/${demo.zip}`} download={demo.zip}>
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
            <span>导出下载（zip）</span>
          </a>
        ) : (
          <a href={`/demos/${demo.file}`} download={demo.file}>
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
            <span>下载单文件</span>
          </a>
        )}
        <a href="/demos/">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
          <span>演示集</span>
        </a>
        <span class="demo-fab-tip">文件受博客密码保护</span>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const stage = document.getElementById('demo-stage') as HTMLElement;
  const fab = document.getElementById('demo-fab') as HTMLElement;
  const menu = document.getElementById('demo-fab-menu') as HTMLElement;

  // 演示层从站点导航底部一直铺到视口底部
  function fit() {
    const header = document.querySelector('.site-header') as HTMLElement | null;
    const top = header ? header.getBoundingClientRect().bottom : 0;
    stage.style.top = `${Math.max(top, 0)}px`;
    stage.style.height = `${Math.max(window.innerHeight - top, 0)}px`;
  }
  fit();
  window.addEventListener('resize', fit);

  fab.addEventListener('click', () => {
    menu.hidden = !menu.hidden;
  });
  document.addEventListener('click', (e) => {
    if (!menu.hidden && !fab.contains(e.target as Node) && !menu.contains(e.target as Node)) {
      menu.hidden = true;
    }
  });
</script>
