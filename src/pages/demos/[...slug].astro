---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { demos } from '../../data/demos';

export function getStaticPaths() {
  return demos
    .filter((demo) => demo.ready)
    .map((demo) => ({ params: { slug: demo.slug }, props: { demo } }));
}

const { demo } = Astro.props;
---

<BaseLayout title={demo.title} description={demo.description}>
  <div class="demo-stage" id="demo-stage">
    <iframe
      class="demo-frame"
      src={`/demos/${demo.file}`}
      title={demo.title}
    ></iframe>
    <div class="demo-fab-wrap">
      <button class="demo-fab" id="demo-fab" type="button" aria-label="演示控制">⋯</button>
      <div class="demo-fab-menu" id="demo-fab-menu" hidden>
        <a href={`/demos/${demo.file}`} target="_blank" rel="noopener">⛶ 全屏打开</a>
        {demo.zip ? (
          <a href={`/demos/${demo.zip}`} download={demo.zip}>⬇️ 导出下载（zip）</a>
        ) : (
          <a href={`/demos/${demo.file}`} download={demo.file}>⬇️ 下载单文件</a>
        )}
        <a href="/demos/">← 演示集</a>
        <span class="demo-fab-tip">文件受博客密码保护</span>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const stage = document.getElementById('demo-stage') as HTMLElement;
  const fab = document.getElementById('demo-fab') as HTMLElement;
  const menu = document.getElementById('demo-fab-menu') as HTMLElement;

  // 演示层从站点导航底部一直铺到视口底部
  function fit() {
    const header = document.querySelector('.site-header') as HTMLElement | null;
    const top = header ? header.getBoundingClientRect().bottom : 0;
    stage.style.top = `${Math.max(top, 0)}px`;
    stage.style.height = `${Math.max(window.innerHeight - top, 0)}px`;
  }
  fit();
  window.addEventListener('resize', fit);

  fab.addEventListener('click', () => {
    menu.hidden = !menu.hidden;
  });
  document.addEventListener('click', (e) => {
    if (!menu.hidden && !fab.contains(e.target as Node) && !menu.contains(e.target as Node)) {
      menu.hidden = true;
    }
  });
</script>
