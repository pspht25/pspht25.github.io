---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('kb', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="知识库">
  <h1>知识库</h1>
  <p class="page-desc">按分类分级浏览，点文件夹逐级进入。</p>

  <nav id="crumbs" aria-label="面包屑"></nav>
  <div id="kb-view"></div>

  {/* 全量条目数据（JS 渲染分级视图） */}
  <ul id="kb-data" hidden>
    {entries.map((entry) => (
      <li
        data-cat={entry.data.category}
        data-title={entry.data.title}
        data-desc={entry.data.description || ''}
        data-href={`/kb/${entry.id}/`}
      ></li>
    ))}
  </ul>

  <style is:global>
    #crumbs { margin: 0 0 14px; font-size: 0.9rem; display: flex; flex-wrap: wrap; gap: 2px; align-items: center; }
    #crumbs:empty { display: none; }
    #crumbs a { color: var(--fg-muted); text-decoration: none; padding: 4px 10px; border-radius: 999px; }
    #crumbs a:hover { background: var(--accent-soft); color: var(--accent); text-decoration: none; }
    #crumbs .sep { color: var(--fg-muted); opacity: 0.45; padding: 0 2px; }
    #crumbs .cur { color: var(--accent); font-weight: 600; padding: 4px 10px; background: var(--accent-soft); border-radius: 999px; }

    .view-head { display: flex; align-items: baseline; gap: 10px; margin: 20px 0 12px; }
    .view-head h2 { font-size: 1.02rem; margin: 0; }
    .view-head .n { color: var(--fg-muted); font-size: 0.82rem; }

    .folder-row {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 14px; margin-bottom: 10px;
      border: 1px solid var(--border); border-radius: 14px;
      background: var(--card); color: var(--fg); text-decoration: none;
      box-shadow: var(--shadow);
      transition: border-color 0.15s, transform 0.15s;
    }
    .folder-row:hover { border-color: var(--accent); transform: translateY(-1px); text-decoration: none; }
    .folder-row .ic { width: 38px; height: 38px; border-radius: 10px; background: var(--accent-soft); display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
    .folder-row .ic svg { width: 20px; height: 20px; fill: var(--accent); }
    .folder-row .nm { flex: 1; font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .folder-row .ct { color: var(--fg-muted); font-size: 0.82rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .folder-row .ar { color: var(--fg-muted); font-size: 0.9rem; flex: 0 0 auto; }

    #kb-view .post-list li { border-bottom: 1px dashed var(--border); }
    #kb-view .post-title { display: flex; align-items: center; gap: 8px; font-weight: 600; }
    #kb-view .post-title svg { width: 15px; height: 15px; fill: var(--accent); flex: 0 0 auto; }

    .empty { color: var(--fg-muted); padding: 28px 0; text-align: center; font-size: 0.9rem; }
  </style>

  <script is:inline>
    (function () {
      var data = Array.prototype.slice.call(document.querySelectorAll('#kb-data li')).map(function (li) {
        return { cat: li.dataset.cat || '未分类', title: li.dataset.title, desc: li.dataset.desc, href: li.dataset.href };
      });
      var view = document.getElementById('kb-view');
      var crumbs = document.getElementById('crumbs');

      function countUnder(prefix) {
        var n = 0;
        for (var i = 0; i < data.length; i++) if (data[i].cat === prefix || data[i].cat.indexOf(prefix + '/') === 0) n++;
        return n;
      }

      function subDirs(path) {
        var segLen = path ? path.split('/').length : 0;
        var set = {};
        for (var i = 0; i < data.length; i++) {
          var segs = data[i].cat.split('/');
          if (segs.length > segLen) {
            var p = segs.slice(0, segLen + 1).join('/');
            if (!path || p.indexOf(path + '/') === 0) set[p] = 1;
          }
        }
        return Object.keys(set).sort(function (a, b) { return a.localeCompare(b, 'zh'); });
      }

      function directPosts(path) {
        return data.filter(function (d) { return d.cat === path; });
      }

      var FOLDER_ICON = 'M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z';
      var DOC_ICON = 'M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z';
      function esc(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function h(tag, cls, text) {
        var el = document.createElement(tag);
        if (cls) el.className = cls;
        if (text != null) el.textContent = text;
        return el;
      }

      function render(path) {
        view.innerHTML = '';
        crumbs.innerHTML = '';
        // 面包屑
        var segs = path ? path.split('/') : [];
        var rootA = document.createElement('a');
        rootA.innerHTML = '<svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:currentColor;vertical-align:-2px"><path d="' + FOLDER_ICON + '"/></svg> 全部';
        rootA.href = '#';
        crumbs.appendChild(rootA);
        var acc = [];
        for (var i = 0; i < segs.length; i++) {
          acc.push(segs[i]);
          crumbs.appendChild(h('span', 'sep', '›'));
          if (i === segs.length - 1) {
            crumbs.appendChild(h('span', 'cur', segs[i]));
          } else {
            var a = h('a', null, segs[i]);
            a.href = '#' + encodeURIComponent(acc.join('/'));
            crumbs.appendChild(a);
          }
        }
        // 子文件夹
        var dirs = subDirs(path);
        if (dirs.length) {
          var hd = h('div', 'view-head');
          hd.appendChild(h('h2', null, '文件夹'));
          hd.appendChild(h('span', 'n', dirs.length + ' 个'));
          view.appendChild(hd);
          for (var j = 0; j < dirs.length; j++) {
            var name = dirs[j].split('/').pop();
            var row = h('a', 'folder-row');
            row.href = '#' + encodeURIComponent(dirs[j]);
            row.innerHTML =
              '<span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="' + FOLDER_ICON + '"/></svg></span>' +
              '<span class="nm">' + esc(name) + '</span>' +
              '<span class="ct">' + countUnder(dirs[j]) + ' 篇</span>' +
              '<span class="ar">›</span>';
            view.appendChild(row);
          }
        }
        // 直属文章
        var posts = directPosts(path);
        if (posts.length || !dirs.length) {
          var ph = h('div', 'view-head');
          ph.appendChild(h('h2', null, '文章'));
          ph.appendChild(h('span', 'n', posts.length + ' 篇'));
          view.appendChild(ph);
          if (!posts.length) {
            view.appendChild(h('div', 'empty', '此文件夹暂无直属文章'));
          } else {
            var ul = h('ul', 'post-list');
            for (var k = 0; k < posts.length; k++) {
              var li = document.createElement('li');
              var a2 = document.createElement('a');
              a2.href = posts[k].href;
              a2.innerHTML =
                '<span class="post-title"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="' + DOC_ICON + '"/></svg>' +
                esc(posts[k].title) + '</span>' +
                (posts[k].desc ? '<span class="post-desc">' + esc(posts[k].desc) + '</span>' : '');
              li.appendChild(a2);
              ul.appendChild(li);
            }
            view.appendChild(ul);
          }
        }
      }

      function route() {
        var raw = decodeURIComponent(location.hash.replace(/^#\/?/, '')).replace(/^\/+|\/+$/g, '');
        render(raw);
      }
      window.addEventListener('hashchange', route);
      route();
    })();
  </script>
</BaseLayout>
