---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Python 笔记本" description="类 Jupyter 的科学计算笔记本：单元格制、变量跨格共享、Out[n] 显示表达式结果、matplotlib 内联绘图，引擎由本站自托管">
  <h1>🧪 Python 笔记本</h1>

  <div class="intro">
    <p>类 Jupyter 的科学计算笔记本，跑在浏览器里的 <b>真 CPython</b>（Pyodide，本站自托管引擎）。单元格逐格运行，<b>变量跨格共享</b>；单元格最后一个表达式的值自动显示为 <code>Out[n]</code>；支持顶层 <code>await</code>；<code>matplotlib</code> 图直接内联。<b>代码只在本地执行</b>。</p>
    <p class="muted">快捷键：<b>Shift+Enter</b> 运行并跳到下一格（末尾则新建一格），<b>Ctrl+Enter</b> 运行停留。首次加载核心运行时约 13 MB，科学包按需加载。</p>
  </div>

  <div class="statusbar">
    <span class="dot" id="dot"></span>
    <span id="status">内核未启动 —— 点「运行」任意单元格即自动就绪</span>
    <span class="ver" id="ver"></span>
    <button class="btn ghost small" id="btnRestart">↻ 重置内核</button>
  </div>

  <div id="cells"></div>

  <div class="toolbar">
    <button class="btn" id="btnAdd">＋ 单元格</button>
    <button class="btn" id="btnRunAll">▶▶ 运行全部</button>
    <span class="hint">Shift+Enter 运行并前进</span>
  </div>
</BaseLayout>

<script id="nb-worker-src" type="text/plain">
// 统一解释器 Worker（笔记本版）：引擎自托管 /vendor/pyodide/，indexURL 由主线程传入
const PKG_MAP = {
  numpy: 'numpy', scipy: 'scipy', pandas: 'pandas',
  matplotlib: 'matplotlib', pylab: 'matplotlib', mpl_toolkits: 'matplotlib',
  PIL: 'pillow', sympy: 'sympy'
};

let pyodide = null;
let initing = false;
let splitFn = null, reprFn = null;
let currentCellId = null;

function post(m) { self.postMessage(m); }

// matplotlib AGG 出图：plt.show() 被替换为把所有 figure 编码为 PNG 发给主线程
const PLT_PATCH = [
  'import io, base64',
  "import js",
  "def _send_fig(*a, **k):",
  "    import matplotlib.pyplot as _plt",
  "    for _n in _plt.get_fignums():",
  "        _buf = io.BytesIO()",
  "        _plt.figure(_n).savefig(_buf, format='png', dpi=110, bbox_inches='tight')",
  "        js.postImage('data:image/png;base64,' + base64.b64encode(_buf.getvalue()).decode())",
  "    _plt.close('all')",
  "import matplotlib.pyplot as plt",
  "plt.show = _send_fig"
].join('\n');

// 笔记本内核：切分单元格（exec 段 + 最后表达式）、repr 截断
const KERNEL_SETUP = [
  'import ast as _ast, json as _json',
  '',
  'def _split_cell(code):',
  '    try:',
  "        tree = _ast.parse(code, mode='exec')",
  '    except SyntaxError:',
  '        return _json.dumps([code, None])',
  '    body = list(tree.body)',
  '    if body and isinstance(body[-1], _ast.Expr):',
  '        seg = _ast.get_source_segment(code, body[-1])',
  '        if seg is not None:',
  '            return _json.dumps([_ast.unparse(_ast.Module(body=body[:-1], type_ignores=[])), seg])',
  '    return _json.dumps([code, None])',
  '',
  'def _repr_out(o):',
  '    r = repr(o)',
  "    return r if len(r) < 1200 else r[:1200] + ' …'"
].join('\n');

self.postImage = function (dataUrl) { post({ type: 'image', id: currentCellId, dataUrl: dataUrl }); };

function detectImports(code) {
  const found = new Set();
  const re = /^[ \t]*(?:import|from)[ \t]+([A-Za-z_][\w.]*)/gm;
  let m;
  while ((m = re.exec(code))) {
    const pkg = PKG_MAP[m[1].split('.')[0]];
    if (pkg) found.add(pkg);
  }
  return Array.from(found);
}

async function ensurePackages(pkgs) {
  for (const p of pkgs) {
    post({ type: 'pkg', name: p, stage: 'loading' });
    await pyodide.loadPackage(p);
    post({ type: 'pkg', name: p, stage: 'loaded' });
  }
}

async function doInit(indexURL) {
  if (pyodide || initing) return;
  initing = true;
  post({ type: 'status', stage: 'loading', text: '启动内核（首次约 13 MB，本站自托管，之后走缓存）…' });
  try {
    importScripts(indexURL + 'pyodide.js');
    pyodide = await loadPyodide({ indexURL: indexURL });
    pyodide.setStdout({ batched: (s) => post({ type: 'stdout', id: currentCellId, text: s }) });
    pyodide.setStderr({ batched: (s) => post({ type: 'stderr', id: currentCellId, text: s }) });
    await pyodide.runPythonAsync(KERNEL_SETUP);
    splitFn = pyodide.globals.get('_split_cell');
    reprFn = pyodide.globals.get('_repr_out');
    const ver = pyodide.runPython('import sys; sys.version.split()[0]');
    post({ type: 'status', stage: 'ready', text: '内核就绪', python: String(ver) });
  } catch (e) {
    post({ type: 'status', stage: 'error', text: '内核启动失败：' + (e && e.message || e) });
    pyodide = null;
  }
  initing = false;
}

async function doRunCell(id, code) {
  if (!pyodide) await doInit(currentIndexURL);
  if (!pyodide) return;
  currentCellId = id;
  try {
    const t0 = Date.now();
    post({ type: 'cell-start', id: id });
    const pkgs = detectImports(code);
    if (pkgs.length) await ensurePackages(pkgs);
    if (/matplotlib|\bplt\b/.test(code)) await pyodide.runPythonAsync(PLT_PATCH);
    const [execCode, evalCode] = JSON.parse(splitFn(code));
    if (evalCode) {
      if (execCode) await pyodide.runPythonAsync(execCode);
    } else {
      await pyodide.runPythonAsync(code);
    }
    let out = null;
    if (evalCode) {
      const val = await pyodide.runPythonAsync('(' + evalCode + ')');
      if (val !== undefined && val !== null) {
        out = reprFn(val);
        if (val && typeof val.destroy === 'function') val.destroy();
      }
    }
    currentCellId = null;
    post({ type: 'cell-result', id: id, out: out, elapsed: Date.now() - t0 });
  } catch (e) {
    currentCellId = null;
    post({ type: 'cell-error', id: id, text: String(e && e.message || e) });
    post({ type: 'cell-result', id: id, out: null, elapsed: -1 });
  }
}

let currentIndexURL = '';
self.onmessage = async (ev) => {
  const d = ev.data || {};
  if (d.cmd === 'init') {
    currentIndexURL = String(d.indexURL || '/vendor/pyodide/v0.29.2/');
    await doInit(currentIndexURL);
  }
  else if (d.cmd === 'run_cell') await doRunCell(d.id | 0, String(d.code || ''));
  else if (d.cmd === 'loadpkg' && pyodide) {
    try { await ensurePackages([String(d.name)]); }
    catch (e) { post({ type: 'error', text: '加载 ' + d.name + ' 失败：' + (e && e.message || e) }); }
  }
};
</script>

<style>
  .intro {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px 18px;
    margin: 1rem 0 0;
    box-shadow: var(--shadow);
  }
  .intro p { margin: 0.3em 0; font-size: 0.94rem; }
  .intro .muted { color: var(--fg-muted); font-size: 0.86rem; }

  .statusbar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 14px 0 10px;
    font-size: 0.88rem;
    color: var(--fg-muted);
    flex-wrap: wrap;
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--border); flex-shrink: 0; }
  .dot.loading { background: #d97706; animation: pulse 1.1s infinite; }
  .dot.ready { background: #16a34a; }
  .dot.error { background: #dc2626; }
  @keyframes pulse { 50% { opacity: 0.35; } }
  .statusbar .ver { font-family: var(--font-mono); font-size: 0.8rem; }

  .cell {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 10px 14px;
    margin: 0 0 12px;
    box-shadow: var(--shadow);
  }
  .cell-head {
    display: flex; align-items: center; gap: 8px;
    margin-bottom: 6px;
  }
  .in-label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: #16a34a;
    min-width: 64px;
  }
  .cell-head .spacer { flex: 1; }
  .cell-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--fg-muted);
    padding: 2px 6px;
    border-radius: 6px;
  }
  .cell-btn:hover { background: var(--bg-soft); color: var(--fg); }
  .cell-btn.run { color: var(--accent); font-weight: 700; }
  /* 高亮编辑器：透明 textarea 叠在高亮 pre 上 */
  .hl-wrap {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .hl-wrap:focus-within { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
  .hl-wrap pre.hl {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    margin: 0;
    padding: 10px 12px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    tab-size: 4;
    color: var(--fg);
    pointer-events: none;
    overflow: hidden;
    white-space: pre-wrap;
    word-break: break-word;
  }
  pre.hl code { font: inherit; }
  .cell textarea {
    position: relative;
    display: block;
    width: 100%;
    min-height: 74px;
    resize: vertical;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    padding: 10px 12px;
    border: none;
    background: transparent;
    color: transparent;
    caret-color: var(--fg);
    tab-size: 4;
    box-sizing: border-box;
  }
  .cell textarea:focus { outline: none; }
  .cell textarea.running { box-shadow: inset 0 0 0 2px #d97706; }
  .tok-kw { color: #8b5cf6; font-weight: 600; }
  .tok-str { color: #b45309; }
  .tok-com { color: var(--fg-muted); font-style: italic; }
  .tok-num { color: #0284c7; }
  .tok-bi { color: #0d9488; }
  .tok-cl { color: #db2777; }

  .cell-out { margin-top: 8px; }
  .out-line {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-all;
    margin: 0;
  }
  .out-line.err { color: #dc2626; }
  .out-line.sys { color: var(--fg-muted); font-size: 0.78rem; }
  .out-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #dc2626;
    margin: 6px 0 0;
  }
  .out-repr {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    white-space: pre-wrap;
    word-break: break-all;
    background: var(--bg-soft);
    border-radius: 8px;
    padding: 6px 10px;
    margin: 4px 0 0;
  }
  .out-img { max-width: 100%; border-radius: 10px; border: 1px solid var(--border); margin: 8px 0 0; display: block; }
  .out-empty { color: var(--fg-muted); font-size: 0.8rem; font-style: italic; }

  .toolbar { display: flex; align-items: center; gap: 10px; margin: 6px 0 30px; flex-wrap: wrap; }
  .btn {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    padding: 8px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
  }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .btn.ghost { background: var(--bg-soft); }
  .btn.small { font-size: 0.78rem; padding: 4px 10px; }
  .hint { color: var(--fg-muted); font-size: 0.8rem; }
</style>

<script>
  const cellsEl = document.getElementById('cells') as HTMLElement;
  const statusEl = document.getElementById('status') as HTMLElement;
  const dotEl = document.getElementById('dot') as HTMLElement;
  const verEl = document.getElementById('ver') as HTMLElement;

  // 引擎自托管路径（随站点 base 自动适配）。
  // 关键：Worker 由 Blob URL 创建，importScripts/loadPyodide 里的相对路径会以 blob: 为 base
  // 解析而失效，因此这里必须解析为完整绝对 URL 再传给 Worker。
  const INDEX_URL = new URL(
    (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/') + 'vendor/pyodide/v0.29.2/',
    document.baseURI
  ).href;

  // ---------- 轻量 Python 语法高亮（零依赖，逐行 tokenizer） ----------
  const KW = new Set('def return if elif else for while import from as with try except finally class in not and or lambda None True False await async yield global nonlocal assert break continue pass raise del is match case'.split(' '));
  const BUILTIN = new Set('print len range int float str list dict set tuple sum min max abs round sorted enumerate zip map filter open type isinstance super bool bytes repr format any all hex oct bin divmod pow iter next getattr setattr hasattr'.split(' '));
  const escHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  function hlPython(src: string): string {
    const out: string[] = [];
    for (const line of src.split('\n')) {
      let html = '';
      let i = 0;
      const n = line.length;
      while (i < n) {
        const c = line[i]!;
        if (c === '#') {
          html += '<span class="tok-com">' + escHtml(line.slice(i)) + '</span>';
          break;
        }
        // 字符串（含 f/r/b/u 前缀；未闭合引号则着色到行尾）
        const sm = line.slice(i).match(/^[A-Za-z]{0,2}("""|'''|"|')/);
        if (sm && sm[0] && !/[\w.]/.test(line[i - 1] ?? '')) {
          const q = sm[1]!;
          const end = line.indexOf(q, i + sm[0].length);
          const stop = end === -1 ? n : end + q.length;
          html += '<span class="tok-str">' + escHtml(line.slice(i, stop)) + '</span>';
          i = stop;
          continue;
        }
        // 数字（避免吃进标识符）
        if (/[0-9]/.test(c) && !/[\w.]/.test(line[i - 1] ?? '')) {
          const nm = line.slice(i).match(/^0[xXbBoO][\da-fA-F_]+|\d[\d_]*(\.\d[\d_]*)?([eE][+-]?\d+)?[jJ]?/);
          if (nm) {
            html += '<span class="tok-num">' + escHtml(nm[0]) + '</span>';
            i += nm[0].length;
            continue;
          }
        }
        // 标识符 / 关键字 / 内建 / 类名
        const im = line.slice(i).match(/^[A-Za-z_]\w*/);
        if (im) {
          const w = im[0];
          const cls = KW.has(w) ? 'tok-kw' : BUILTIN.has(w) ? 'tok-bi' : /^[A-Z][A-Za-z0-9_]*$/.test(w) ? 'tok-cl' : '';
          html += cls ? '<span class="' + cls + '">' + escHtml(w) + '</span>' : escHtml(w);
          i += w.length;
          continue;
        }
        html += escHtml(c);
        i++;
      }
      out.push(html);
    }
    return out.join('\n');
  }

  interface Cell { id: number; el: HTMLElement; ta: HTMLTextAreaElement; out: HTMLElement; num: number | null; }
  let cells: Cell[] = [];
  let nextId = 1;
  let execCount = 0;
  let ready = false;
  let running = false;
  let worker: Worker | null = null;
  const pending = new Map<number, { resolve: (v: any) => void }>();

  const WORKER_SRC = document.getElementById('nb-worker-src')!.textContent ?? '';

  function spawnWorker() {
    worker = new Worker(URL.createObjectURL(new Blob([WORKER_SRC], { type: 'application/javascript' })));
    worker.onmessage = (ev: MessageEvent) => {
      const d = ev.data || {};
      if (d.type === 'status') {
        setDot(d.stage);
        statusEl.textContent = d.text;
        if (d.stage === 'ready') {
          ready = true;
          verEl.textContent = 'CPython ' + (d.python || '') + ' · 自托管 v0.29.2';
        } else if (d.stage === 'error') {
          ready = false;
        }
      } else if (d.type === 'stdout' || d.type === 'stderr') {
        const c = cells.find((x) => x.id === d.id);
        if (c) {
          const empty = c.out.querySelector('.out-empty');
          if (empty) empty.remove();
          const p = document.createElement('div');
          p.className = 'out-line' + (d.type === 'stderr' ? ' err' : '');
          p.textContent = d.text;
          c.out.appendChild(p);
        }
      } else if (d.type === 'image') {
        const c = cells.find((x) => x.id === d.id);
        if (c) {
          const empty = c.out.querySelector('.out-empty');
          if (empty) empty.remove();
          const img = document.createElement('img');
          img.className = 'out-img';
          img.src = d.dataUrl;
          c.out.appendChild(img);
        }
      } else if (d.type === 'cell-error') {
        const c = cells.find((x) => x.id === d.id);
        if (c) {
          const empty = c.out.querySelector('.out-empty');
          if (empty) empty.remove();
          const p = document.createElement('div');
          p.className = 'out-line err';
          p.textContent = d.text;
          c.out.appendChild(p);
        }
      } else if (d.type === 'cell-result') {
        const c = cells.find((x) => x.id === d.id);
        if (c && d.out !== null && d.out !== undefined) {
          const tag = document.createElement('div');
          tag.className = 'out-tag';
          tag.textContent = 'Out[' + (c.num ?? '') + ']:';
          const pre = document.createElement('div');
          pre.className = 'out-repr';
          pre.textContent = d.out;
          c.out.appendChild(tag);
          c.out.appendChild(pre);
        }
        if (c) {
          c.ta.classList.remove('running');
        }
        running = false;
        const p = pending.get(d.id);
        if (p) { pending.delete(d.id); p.resolve(d); }
      } else if (d.type === 'pkg') {
        statusEl.textContent = (d.stage === 'loading' ? '加载 ' + d.name + ' …' : d.name + ' 已就绪');
      }
    };
    worker.onerror = (e) => {
      setDot('error');
      statusEl.textContent = 'Worker 异常：' + (e.message || '未知错误');
      running = false;
    };
  }

  function setDot(cls: string) {
    dotEl.className = 'dot ' + cls;
  }

  function mkCell(code: string, afterId?: number): Cell {
    const id = nextId++;
    const el = document.createElement('div');
    el.className = 'cell';
    el.innerHTML = `
      <div class="cell-head">
        <span class="in-label">In [ ]:</span>
        <span class="spacer"></span>
        <button class="cell-btn run" title="运行 (Ctrl+Enter)">▶</button>
        <button class="cell-btn del" title="删除单元格">✕</button>
      </div>
      <div class="hl-wrap">
        <pre class="hl" aria-hidden="true"><code></code></pre>
        <textarea spellcheck="false" autocapitalize="off"></textarea>
      </div>
      <div class="cell-out"><div class="out-empty">输出显示在这里</div></div>`;
    const ta = el.querySelector('textarea') as HTMLTextAreaElement;
    ta.value = code;
    const out = el.querySelector('.cell-out') as HTMLElement;
    const cell: Cell = { id, el, ta, out, num: null };
    const label = el.querySelector('.in-label') as HTMLElement;
    const btnRun = el.querySelector('.cell-btn.run') as HTMLButtonElement;
    const btnDel = el.querySelector('.cell-btn.del') as HTMLButtonElement;

    const hlWrap = el.querySelector('.hl-wrap') as HTMLElement;
    const hlCode = hlWrap.querySelector('code') as HTMLElement;
    const syncHl = () => { hlCode.innerHTML = hlPython(ta.value) + '\n'; };
    const autoH = () => { ta.style.height = 'auto'; ta.style.height = Math.max(74, ta.scrollHeight) + 'px'; };
    ta.addEventListener('input', () => { autoH(); syncHl(); });
    ta.addEventListener('scroll', () => {
      hlWrap.scrollTop = ta.scrollTop;
      hlWrap.scrollLeft = ta.scrollLeft;
    });

    btnRun.addEventListener('click', () => runCell(cell));
    btnDel.addEventListener('click', () => {
      if (cells.length <= 1) return;
      cells = cells.filter((c) => c.id !== id);
      el.remove();
      renumber();
    });

    ta.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        e.preventDefault();
        ta.setRangeText('    ', ta.selectionStart, ta.selectionEnd, 'end');
      } else if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        runCell(cell);
      } else if (e.shiftKey && e.key === 'Enter') {
        e.preventDefault();
        const idx = cells.indexOf(cell);
        if (idx === cells.length - 1) {
          const nc = mkCell('');
          cells.splice(idx + 1, 0, nc);
          cellsEl.appendChild(nc.el);
          runCell(cell);
          (nc.ta as HTMLTextAreaElement).focus();
        } else {
          runCell(cell);
          (cells[idx + 1].ta as HTMLTextAreaElement).focus();
        }
      }
    });

    if (afterId !== undefined) {
      const idx = cells.findIndex((c) => c.id === afterId);
      cells.splice(idx + 1, 0, cell);
      const ref = cells[idx].el;
      ref.parentElement!.insertBefore(el, ref.nextSibling);
    } else {
      cells.push(cell);
      cellsEl.appendChild(el);
    }
    renumber();
    autoH();
    syncHl();
    return cell;
  }

  function renumber() {
    cells.forEach((c, i) => {
      const lab = c.el.querySelector('.in-label') as HTMLElement;
      lab.textContent = c.num !== null ? 'In [' + c.num + ']:' : 'In [' + (i + 1) + ']:';
    });
  }

  function runCell(cell: Cell): Promise<any> {
    if (!cell.ta.value.trim()) return Promise.resolve(null);
    if (!worker) spawnWorker();
    if (running) {
      appendSys(cell, '内核忙（前一单元格还在运行），请稍候');
      return Promise.resolve(null);
    }
    if (!ready) statusEl.textContent = '内核启动中…完成后自动运行';
    cell.num = ++execCount;
    cell.out.innerHTML = '<div class="out-empty">运行中…</div>';
    cell.ta.classList.add('running');
    renumber();
    running = true;
    return new Promise((resolve) => {
      pending.set(cell.id, { resolve });
      worker!.postMessage({ cmd: 'run_cell', id: cell.id, code: cell.ta.value });
    });
  }

  function appendSys(cell: Cell, text: string) {
    const empty = cell.out.querySelector('.out-empty');
    if (empty) empty.remove();
    const p = document.createElement('div');
    p.className = 'out-line sys';
    p.textContent = text;
    cell.out.appendChild(p);
  }

  async function runAll() {
    if (running) return;
    for (const c of [...cells]) {
      if (!c.ta.value.trim()) continue;
      await runCell(c);
    }
  }

  function restartKernel() {
    if (worker) { worker.terminate(); worker = null; }
    ready = false;
    running = false;
    pending.clear();
    execCount = 0;
    cells.forEach((c) => { c.num = null; c.out.innerHTML = '<div class="out-empty">输出显示在这里</div>'; });
    renumber();
    setDot('error');
    statusEl.textContent = '内核已重置（变量清空，引擎缓存仍在，秒级就绪）';
    spawnWorker();
    worker!.postMessage({ cmd: 'init', indexURL: INDEX_URL });
  }

  document.getElementById('btnAdd')!.addEventListener('click', () => {
    const last = cells[cells.length - 1];
    const c = mkCell('', last ? last.id : undefined);
    c.ta.focus();
  });
  document.getElementById('btnRunAll')!.addEventListener('click', runAll);
  document.getElementById('btnRestart')!.addEventListener('click', restartKernel);

  // 初始示例：两格演示状态共享
  mkCell(`import numpy as np

rng = np.random.default_rng(7)
t = np.linspace(0, 4 * np.pi, 400)
signal = np.sin(t) * np.exp(-0.15 * t) + rng.normal(0, 0.04, t.size)
print("数据就绪:", signal.shape, "均值", round(float(signal.mean()), 4))`);
  mkCell(`import matplotlib.pyplot as plt

plt.figure(figsize=(7, 3.5))
plt.plot(t, signal, lw=0.8, alpha=0.7, label="含噪信号")
plt.plot(t, np.sin(t) * np.exp(-0.15 * t), lw=2, label="真值")
plt.legend()
plt.title("本格直接使用上一格的变量 t / signal")
plt.show()
signal.std()`);
</script>
