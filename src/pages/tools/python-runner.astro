---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Python 解释器" description="浏览器里的真 Python：CPython 编译为 WebAssembly，支持 numpy / scipy / matplotlib，代码全部在本地运行">
  <h1>🐍 Python 解释器</h1>

  <div class="intro">
    <p>这是运行在浏览器里的 <b>真 CPython</b>（Pyodide：CPython 编译为 WebAssembly），不是模拟器。支持 <code>numpy / scipy / pandas / matplotlib / sympy</code> 等科学栈，按需自动加载。<b>代码只在你的浏览器本地执行</b>，不经过任何服务器。</p>
    <p class="muted">解释器引擎由本站<b>自托管</b>（<code>/vendor/pyodide/v0.29.2/</code>），不依赖任何第三方 CDN。首次加载核心运行时约 13 MB，科学包按需加载；浏览器缓存全站共享，之后秒级就绪。</p>
  </div>

  <div class="statusbar">
    <span class="dot" id="dot"></span>
    <span id="status">引擎未加载 —— 点「运行」或任意示例即自动就绪</span>
    <span class="ver" id="ver"></span>
  </div>

  <div class="pkgbar">
    <span class="lbl">科学包：</span>
    <button class="pkg" data-pkg="numpy">numpy</button>
    <button class="pkg" data-pkg="scipy">scipy</button>
    <button class="pkg" data-pkg="pandas">pandas</button>
    <button class="pkg" data-pkg="matplotlib">matplotlib</button>
    <button class="pkg" data-pkg="sympy">sympy</button>
    <span class="pkg-hint" id="pkgHint">运行代码时检测到 import 会自动加载，也可手动预载</span>
  </div>

  <div class="editor">
    <textarea id="code" spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="Python 代码"></textarea>
  </div>

  <div class="toolbar">
    <button class="btn run" id="btnRun">▶ 运行 <span class="kbd">Ctrl↵</span></button>
    <button class="btn stop" id="btnStop" disabled>⏹ 停止</button>
    <span class="sep"></span>
    <span class="lbl">示例：</span>
    <button class="btn ghost demo" data-demo="basic">基础</button>
    <button class="btn ghost demo" data-demo="numpy">numpy</button>
    <button class="btn ghost demo" data-demo="mpl">matplotlib</button>
    <span class="sep"></span>
    <button class="btn ghost" id="btnClear">清空输出</button>
    <span class="elapsed" id="elapsed"></span>
  </div>

  <div class="output">
    <div id="out"><div class="out-empty">输出会显示在这里。试试上面的示例。</div></div>
  </div>
</BaseLayout>

<script id="py-worker-src" type="text/plain">
// 统一解释器 Worker：引擎由本站自托管（/vendor/pyodide/），indexURL 由主线程传入
const PKG_MAP = {
  numpy: 'numpy', scipy: 'scipy', pandas: 'pandas',
  matplotlib: 'matplotlib', pylab: 'matplotlib', mpl_toolkits: 'matplotlib',
  PIL: 'pillow', sympy: 'sympy'
};

let pyodide = null;
let initing = false;

function post(m) { self.postMessage(m); }

// matplotlib AGG 出图：plt.show() 被替换为把所有 figure 编码为 PNG 发给主线程
const PLT_PATCH = [
  'import io, base64',
  "import js",
  "def _send_fig(*a, **k):",
  "    import matplotlib.pyplot as _plt",
  "    for _n in _plt.get_fignums():",
  "        _buf = io.BytesIO()",
  "        _plt.figure(_n).savefig(_buf, format='png', dpi=110, bbox_inches='tight')",
  "        js.postImage('data:image/png;base64,' + base64.b64encode(_buf.getvalue()).decode())",
  "    _plt.close('all')",
  "import matplotlib.pyplot as plt",
  "plt.show = _send_fig"
].join('\n');

self.postImage = function (dataUrl) { post({ type: 'image', dataUrl: dataUrl }); };

function detectImports(code) {
  const found = new Set();
  const re = /^[ \t]*(?:import|from)[ \t]+([A-Za-z_][\w.]*)/gm;
  let m;
  while ((m = re.exec(code))) {
    const root = m[1].split('.')[0];
    const pkg = PKG_MAP[root];
    if (pkg) found.add(pkg);
  }
  return Array.from(found);
}

async function ensurePackages(pkgs) {
  for (const p of pkgs) {
    post({ type: 'pkg', name: p, stage: 'loading' });
    await pyodide.loadPackage(p);
    post({ type: 'pkg', name: p, stage: 'loaded' });
  }
}

async function doInit(indexURL) {
  if (pyodide || initing) return;
  initing = true;
  post({ type: 'status', stage: 'loading', text: '加载引擎（首次约 13 MB，本站自托管，之后走缓存）…' });
  try {
    importScripts(indexURL + 'pyodide.js');
    pyodide = await loadPyodide({ indexURL: indexURL });
    pyodide.setStdout({ batched: (s) => post({ type: 'stdout', text: s }) });
    pyodide.setStderr({ batched: (s) => post({ type: 'stderr', text: s }) });
    const ver = pyodide.runPython('import sys; sys.version.split()[0]');
    post({ type: 'status', stage: 'ready', text: '就绪', python: String(ver) });
  } catch (e) {
    post({ type: 'status', stage: 'error', text: '引擎加载失败：' + (e && e.message || e) });
    pyodide = null;
  }
  initing = false;
}

async function doRun(code) {
  if (!pyodide) { await doInit(currentIndexURL); }
  if (!pyodide) return;
  try {
    const t0 = Date.now();
    const pkgs = detectImports(code);
    if (pkgs.length) await ensurePackages(pkgs);
    if (/matplotlib|\bplt\b/.test(code)) await pyodide.runPythonAsync(PLT_PATCH);
    await pyodide.runPythonAsync(code);
    post({ type: 'result', elapsed: Date.now() - t0 });
  } catch (e) {
    post({ type: 'error', text: String(e && e.message || e) });
    post({ type: 'result', elapsed: -1 });
  }
}

let currentIndexURL = '';
self.onmessage = async (ev) => {
  const d = ev.data || {};
  if (d.cmd === 'init') {
    currentIndexURL = String(d.indexURL || '/vendor/pyodide/v0.29.2/');
    await doInit(currentIndexURL);
  }
  else if (d.cmd === 'run') await doRun(String(d.code || ''));
  else if (d.cmd === 'loadpkg' && pyodide) {
    try { await ensurePackages([String(d.name)]); }
    catch (e) { post({ type: 'error', text: '加载 ' + d.name + ' 失败：' + (e && e.message || e) }); }
  }
};
</script>

<style>
  .intro {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px 18px;
    margin: 1rem 0 0;
    box-shadow: var(--shadow);
  }
  .intro p { margin: 0.3em 0; font-size: 0.94rem; }
  .intro .muted { color: var(--fg-muted); font-size: 0.86rem; }

  .statusbar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 14px 0 10px;
    font-size: 0.88rem;
    color: var(--fg-muted);
    flex-wrap: wrap;
  }
  .dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--border);
    flex-shrink: 0;
  }
  .dot.loading { background: #d97706; animation: pulse 1.1s infinite; }
  .dot.ready { background: #16a34a; }
  .dot.error { background: #dc2626; }
  @keyframes pulse { 50% { opacity: 0.35; } }
  .statusbar .ver { font-family: var(--font-mono); font-size: 0.8rem; }

  .pkgbar {
    display: flex; align-items: center; gap: 8px;
    flex-wrap: wrap;
    margin: 0 0 12px;
    font-size: 0.84rem;
  }
  .pkgbar .lbl { color: var(--fg-muted); }
  .pkg {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    padding: 3px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg-muted);
    cursor: pointer;
  }
  .pkg:hover { border-color: var(--accent); color: var(--accent); }
  .pkg.loading { border-color: #d97706; color: #d97706; }
  .pkg.loaded { border-color: #16a34a; color: #16a34a; background: rgba(22,163,74,.08); }
  .pkg-hint { color: var(--fg-muted); font-size: 0.78rem; }

  .editor textarea {
    width: 100%;
    min-height: 240px;
    resize: vertical;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    line-height: 1.6;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-soft);
    color: var(--fg);
    tab-size: 4;
  }
  .editor textarea:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }

  .toolbar {
    display: flex; align-items: center; gap: 8px;
    flex-wrap: wrap;
    margin: 12px 0;
  }
  .btn {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    padding: 8px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
  }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn.run { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
  .btn.run:hover { color: #fff; filter: brightness(1.08); }
  .btn.run:disabled { opacity: 0.45; cursor: not-allowed; }
  .btn.stop { color: #dc2626; border-color: #dc2626; }
  .btn.stop:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn.ghost { background: var(--bg-soft); }
  .kbd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.75;
    border: 1px solid rgba(255,255,255,.4);
    border-radius: 4px;
    padding: 0 4px;
    margin-left: 4px;
  }
  .sep { width: 1px; height: 20px; background: var(--border); margin: 0 4px; }
  .lbl { color: var(--fg-muted); font-size: 0.86rem; }
  .elapsed { color: var(--fg-muted); font-size: 0.82rem; font-family: var(--font-mono); margin-left: auto; }

  .output {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px 16px;
    min-height: 120px;
    max-height: 480px;
    overflow: auto;
    box-shadow: var(--shadow);
  }
  .out-empty { color: var(--fg-muted); font-size: 0.88rem; }
  :global(.out-line) {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-all;
    margin: 0;
  }
  :global(.out-line.err) { color: #dc2626; }
  :global(.out-line.sys) { color: var(--fg-muted); font-size: 0.8rem; }
  :global(.out-img) { max-width: 100%; border-radius: 10px; border: 1px solid var(--border); margin: 8px 0; display: block; }
</style>

<script>
  const codeEl = document.getElementById('code') as HTMLTextAreaElement;
  const statusEl = document.getElementById('status') as HTMLElement;
  const dotEl = document.getElementById('dot') as HTMLElement;
  const verEl = document.getElementById('ver') as HTMLElement;
  const outEl = document.getElementById('out') as HTMLElement;
  const elapsedEl = document.getElementById('elapsed') as HTMLElement;
  const btnRun = document.getElementById('btnRun') as HTMLButtonElement;
  const btnStop = document.getElementById('btnStop') as HTMLButtonElement;
  const pkgHint = document.getElementById('pkgHint') as HTMLElement;

  let ready = false;
  let pendingRun: string | null = null;
  let worker: Worker | null = null;

  // 引擎自托管路径（随站点 base 自动适配）
  const INDEX_URL = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/') + 'vendor/pyodide/v0.29.2/';

  const DEMOS: Record<string, string> = {
    basic: `# 纯 Python：斐波那契与无限精度整数
def fib(n):
    a, b = 0, 1
    for _ in range(n):
        a, b = b, a + b
    return a

print([fib(i) for i in range(15)])

import sys
print("Python", sys.version.split()[0], "on", sys.platform)
print("2 ** 100 =", 2 ** 100)`,
    numpy: `import numpy as np

rng = np.random.default_rng(42)
A = rng.normal(size=(4, 4))
u, s, vt = np.linalg.svd(A)
print("奇异值:", np.round(s, 3))
print("重构误差:", abs(u @ np.diag(s) @ vt - A).max())

# 呼应演示集：双边滤波的 5x5 高斯核
x = np.arange(-2, 3)
g = np.exp(-(x**2 + x[:, None]**2) / (2 * 1.2**2))
print("高斯核权重和 =", round(float(g.sum()), 4))
print(np.round(g / g.sum(), 3))`,
    mpl: `import numpy as np
import matplotlib.pyplot as plt

t = np.linspace(0, 4 * np.pi, 400)
plt.figure(figsize=(7, 3.5))
plt.plot(t, np.sin(t), label="sin")
plt.plot(t, np.sin(t) * np.exp(-0.15 * t), label="衰减振荡")
plt.legend()
plt.title("Pyodide: matplotlib AGG 渲染")
plt.show()
print("图已通过 plt.show() 输出")`,
  };

  function setDot(cls: string) {
    dotEl.className = 'dot ' + cls;
  }

  function clearEmpty() {
    const empty = outEl.querySelector('.out-empty');
    if (empty) empty.remove();
  }

  function addLine(text: string, cls: string) {
    clearEmpty();
    const p = document.createElement('div');
    p.className = 'out-line ' + cls;
    p.textContent = text;
    outEl.appendChild(p);
    outEl.parentElement!.scrollTop = outEl.parentElement!.scrollHeight;
  }

  function addImage(dataUrl: string) {
    clearEmpty();
    const img = document.createElement('img');
    img.className = 'out-img';
    img.src = dataUrl;
    outEl.appendChild(img);
    outEl.parentElement!.scrollTop = outEl.parentElement!.scrollHeight;
  }

  function setPkgBtn(name: string, stage: string) {
    document.querySelectorAll<HTMLButtonElement>('.pkg').forEach((b) => {
      if (b.dataset.pkg === name || (name === 'scikit-learn' && b.dataset.pkg === 'sklearn')) {
        b.classList.remove('loading', 'loaded');
        b.classList.add(stage);
      }
    });
  }

  // Worker 源码来自页内 <script type="text/plain">，Blob URL 创建（单文件、无跨域脚本）
  const WORKER_SRC = document.getElementById('py-worker-src')!.textContent ?? '';

  function spawnWorker() {
    worker = new Worker(URL.createObjectURL(new Blob([WORKER_SRC], { type: 'application/javascript' })));
    worker.onmessage = (ev: MessageEvent) => {
      const d = ev.data || {};
      if (d.type === 'status') {
        setDot(d.stage);
        statusEl.textContent = d.text;
        if (d.stage === 'ready') {
          ready = true;
          verEl.textContent = 'CPython ' + (d.python || '') + ' · 自托管 v0.29.2';
          btnRun.disabled = false;
          btnStop.disabled = true;
          if (pendingRun !== null) {
            const code = pendingRun;
            pendingRun = null;
            startRun(code);
          }
        } else if (d.stage === 'loading') {
          btnRun.disabled = true;
          btnStop.disabled = true;
        } else if (d.stage === 'error') {
          ready = false;
          btnRun.disabled = false;
          btnStop.disabled = true;
        }
      } else if (d.type === 'stdout') {
        addLine(d.text, 'ok');
      } else if (d.type === 'stderr') {
        addLine(d.text, 'err');
      } else if (d.type === 'error') {
        addLine(String(d.text), 'err');
      } else if (d.type === 'image') {
        addImage(d.dataUrl);
      } else if (d.type === 'pkg') {
        setPkgBtn(d.name, d.stage);
        pkgHint.textContent = d.stage === 'loading' ? '正在加载 ' + d.name + ' …' : d.name + ' 已就绪';
      } else if (d.type === 'result') {
        btnStop.disabled = true;
        btnRun.disabled = false;
        elapsedEl.textContent = d.elapsed >= 0 ? (d.elapsed / 1000).toFixed(2) + ' s' : '';
      }
    };
    worker.onerror = (e) => {
      setDot('error');
      statusEl.textContent = 'Worker 异常：' + (e.message || '未知错误');
      btnRun.disabled = false;
      btnStop.disabled = true;
    };
  }

  function startRun(code: string) {
    if (!worker) spawnWorker();
    btnRun.disabled = true;
    btnStop.disabled = false;
    elapsedEl.textContent = '';
    addLine('────────── 运行 ──────────', 'sys');
    worker!.postMessage({ cmd: 'run', code: code });
  }

  function runOrQueue() {
    const code = codeEl.value;
    if (!code.trim()) return;
    if (ready) {
      startRun(code);
    } else {
      pendingRun = code;
      if (!worker) spawnWorker();
      statusEl.textContent = '引擎加载中…完成后自动运行';
      setDot('loading');
      btnRun.disabled = true;
      worker!.postMessage({ cmd: 'init', indexURL: INDEX_URL });
    }
  }

  function stopRun() {
    if (worker) {
      worker.terminate();
      worker = null;
    }
    ready = false;
    pendingRun = null;
    setDot('error');
    statusEl.textContent = '已停止。引擎将重新就绪（缓存加速，约 2–4 秒）';
    btnStop.disabled = true;
    btnRun.disabled = false;
    // 预热：静默重建，下次点运行秒级就绪
    spawnWorker();
    worker!.postMessage({ cmd: 'init', indexURL: INDEX_URL });
  }

  btnRun.addEventListener('click', runOrQueue);
  btnStop.addEventListener('click', stopRun);
  document.getElementById('btnClear')!.addEventListener('click', () => {
    outEl.innerHTML = '<div class="out-empty">输出会显示在这里。试试上面的示例。</div>';
    elapsedEl.textContent = '';
  });

  document.querySelectorAll<HTMLButtonElement>('.demo').forEach((b) => {
    b.addEventListener('click', () => {
      codeEl.value = DEMOS[b.dataset.demo ?? 'basic'] ?? '';
      runOrQueue();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.pkg').forEach((b) => {
    b.addEventListener('click', () => {
      const name = b.dataset.pkg ?? '';
      if (!ready) {
        pendingRun = null;
        if (!worker) spawnWorker();
        setDot('loading');
        statusEl.textContent = '引擎加载中…就绪后自动加载 ' + name;
        worker!.postMessage({ cmd: 'init', indexURL: INDEX_URL });
        const once = (ev: MessageEvent) => {
          const d = ev.data || {};
          if (d.type === 'status' && d.stage === 'ready') {
            worker!.postMessage({ cmd: 'loadpkg', name: name });
            worker!.removeEventListener('message', once);
          }
        };
        worker!.addEventListener('message', once);
        return;
      }
      worker!.postMessage({ cmd: 'loadpkg', name: name });
    });
  });

  codeEl.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') {
      e.preventDefault();
      codeEl.setRangeText('    ', codeEl.selectionStart, codeEl.selectionEnd, 'end');
    } else if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      runOrQueue();
    }
  });

  codeEl.value = DEMOS.basic;
  spawnWorker();
</script>
